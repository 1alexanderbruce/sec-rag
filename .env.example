# Copy to .env and fill in. Never commit .env.

# Required: API key for an OpenAI-compatible provider
LLM_API_KEY=your-api-key-here

# Optional: point at any OpenAI-compatible endpoint (default: OpenAI)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# EMBEDDING_MODEL=text-embedding-3-small

# Required by SEC EDGAR: identify yourself, e.g. "Jane Doe jane@example.com"
SEC_USER_AGENT=your-name your-email@example.com

# Optional: cost display rates, USD per million tokens
# LLM_INPUT_COST_PER_M=2.50
# LLM_OUTPUT_COST_PER_M=10.00

# Optional: outbound proxy (standard variables are honored)
# HTTPS_PROXY=http://proxy.example.com:8080

# Optional: app settings
# SEC_RAG_PORT=7860
# SEC_RAG_SHARE=0
